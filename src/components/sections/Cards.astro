---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;

import Card from "../../components/ui/Card.astro";

const cardsData = [
  {
    h2Text: "Services",
    chip: "Industrial Care",
    description:
      "Emergency response, scheduled maintenance, and complete battery health programs designed to reduce downtime and operational costs.",
    srcImage: "/services.webp",
    href: "/services",
  },
  {
    h2Text: "Chargers",
    chip: "Power Systems",
    description:
      "Authorized PBM industrial chargers with proven reliability, high charging efficiency, and the right configuration for your fleet.",
    srcImage: "/charger.webp",
    href: "/chargerss",
  },
  {
    h2Text: "About Us",
    chip: "Trusted Team",
    description:
      "A technical team focused on long-term partnerships, practical engineering, and dependable support for industrial energy operations.",
    srcImage: "/about.webp",
    href: "/marco",
  },
];
---

<section class:list={["relative", "overflow-hidden", "mx-auto", "max-w-7xl", "px-6", "py-20", className]}>
  <div class="absolute -left-28 top-16 h-64 w-64 rounded-full bg-cyan-300/20 blur-3xl"></div>
  <div class="absolute -right-28 bottom-0 h-72 w-72 rounded-full bg-emerald-400/20 blur-3xl"></div>

  <div class:list={["relative", "text-center", "max-w-4xl", "mx-auto", "mb-14"]}>
    <p class="mb-4 inline-block rounded-full border border-[#0c6f56]/20 bg-white/70 px-4 py-1 text-xs font-bold uppercase tracking-[0.14em] text-[#0c6f56]">
      Industrial Energy Excellence
    </p>
    <h3
      class:list={[
        "text-4xl md:text-6xl",
        "font-bold",
        "text-[#08343f]",
        "mb-6",
      ]}
    >
      Precision Solutions for Battery Performance
    </h3>
    <p
      class:list={[
        "text-base md:text-lg",
        "text-slate-700",
        "max-w-3xl",
        "mx-auto",
        "leading-relaxed",
      ]}
    >
      We combine technical know-how, high-quality equipment, and responsive support
      to keep your operation efficient, safe, and always ready.
    </p>
  </div>

  <div
    class:list={[
      "relative",
      "z-10",
      "flex",
      "justify-center",
      "items-start",
      "gap-8 lg:gap-10",
      "flex-wrap",
    ]}
  >
    {
      cardsData.map((card) => (
        <Card
          h2Text={card.h2Text}
          chip={card.chip}
          description={card.description}
          srcImage={card.srcImage}
          href={card.href}
        />
      ))
    }
  </div>
</section>
