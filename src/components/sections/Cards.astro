---
interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props as Props;

import Card from "../../components/ui/Card.astro";

const cardsData = [
  {
    h2Text: "Services",
    description:
      "GIBS can service your company’s battery needs on an emergency, service call, or  regular planned maintenance.  Let us show you how to save money AND be environmentally friendly!",
    srcImage: "/services.webp",
    srcDireccion: "/services",
  },
  {
    h2Text: "Chargers",
    description:
      "GIBS is an authorized PBM Industrial Chargers dealer. PBM has been manufacturing industrial chargers for almost 50 years! We only sell quality products.",
    srcImage: "/about.webp",
    srcDireccion: "/chargers",
  },
  {
    h2Text: "About Us",
    description:
      "Learn why the team at Green Industrial Battery Service is ahead of the competition!  Innovative and competitive, we earn our business through trust and respect",
    srcImage: "/about.webp",
    srcDireccion: "/about",
  },
];
---

<section
  id={id}
  class:list={[
    "relative",
    "overflow-hidden",
    "w-full",
    "bg-gradient-to-br",
    "from-[#052714]",
    "via-[#031d0f]",
    "to-[#041a15]",
    className,
  ]}
>
  <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-400/20 blur-3xl"></div>

  <div class:list={["relative", "z-10", "mx-auto", "max-w-7xl", "px-6", "py-20"]}>
    <div class:list={["text-center", "mb-14"]}>
      <p class="mb-4 text-sm font-semibold tracking-[0.28em] text-emerald-200 uppercase">
        What We Offer
      </p>
      <h3 class:list={["text-3xl", "md:text-5xl", "lg:text-6xl", "font-bold", "text-white", "mb-6", "leading-tight"]}>
        Leading experts in industrial battery systems
      </h3>
      <p
        class:list={[
          "text-base",
          "md:text-lg",
          "text-emerald-100/90",
          "max-w-4xl",
          "font-serif",
          "mx-auto",
        ]}
      >
        Green Industrial Battery Service combines experience, cutting-edge
        technology, and personalized support to keep your operations running
        smoothly and efficiently.
      </p>
    </div>

    <div class:list={["grid", "grid-cols-1", "md:grid-cols-2", "xl:grid-cols-3", "gap-8", "items-stretch", "justify-items-center"]}>
      {
        cardsData.map((card) => (
          <Card
            h2Text={card.h2Text}
            description={card.description}
            srcImage={card.srcImage}
            srcDireccion={card.srcDireccion}
          />
        ))
      }
    </div>
  </div>
</section>
