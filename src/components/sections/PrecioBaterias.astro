---
import CardPrecioBaterias from "../ui/CardPrecioBaterias.astro";

const batteries = [
  {
    title: "24V Forklift Battery",
    price: "$1,445+",
    idealFor: "Pallet jacks, walkie stackers and electric pallet trucks.",
    features: [
      "Professionally tested battery",
      "Warranty included",
      "Fast delivery available",
    ],
    href:
      "https://wa.me/17142737944?text=Hello!%20I'm%20interested%20in%20your%2024V%20Forklift%20Battery%20starting%20at%20%241445.%20Could%20you%20please%20provide%20more%20information%20about%20availability,%20compatibility,%20and%20pricing?%20Thank%20you!",
  },

  {
    title: "36V Forklift Battery",
    price: "$1,945+",
    idealFor: "Reach trucks, order pickers and light warehouse equipment.",
    features: [
      "Reliable refurbished option",
      "Trade-in available",
      "Expert battery support",
    ],
    href:
      "https://wa.me/17142737944?text=Hello!%20I'm%20interested%20in%20your%2036V%20Forklift%20Battery%20starting%20at%20%241945.%20Could%20you%20please%20provide%20more%20information%20about%20availability,%20compatibility,%20and%20pricing?%20Thank%20you!",
  },

  {
    title: "48V Forklift Battery",
    price: "$2,945+",
    idealFor: "Counterbalance forklifts and high-demand warehouse equipment.",
    features: [
      "Tested before delivery",
      "Built for daily operation",
      "Great value for warehouses",
    ],
    href:
      "https://wa.me/17142737944?text=Hello!%20I'm%20interested%20in%20your%2048V%20Forklift%20Battery%20starting%20at%20%242945.%20Could%20you%20please%20provide%20more%20information%20about%20availability,%20compatibility,%20and%20pricing?%20Thank%20you!",
  },

  {
    title: "80V Forklift Battery",
    price: "$4,945+",
    idealFor: "Heavy-duty forklifts and industrial applications.",
    features: [
      "Heavy-duty performance",
      "Warranty included",
      "Ready for demanding work",
    ],
    href:
      "https://wa.me/17142737944?text=Hello!%20I'm%20interested%20in%20your%2080V%20Forklift%20Battery%20starting%20at%20%244945.%20Could%20you%20please%20provide%20more%20information%20about%20availability,%20compatibility,%20and%20pricing?%20Thank%20you!",
  },
];

const benefits = [
  "Warranty Included",
  "Fast Delivery",
  "Professionally Tested",
  "Expert Support",
];
---

<section
  class="relative overflow-hidden bg-gradient-to-b
    bg-green-950
    via-[#145a35]
    to-[#0b3b22] px-5 py-20 md:px-10"
>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div data-reveal class="mx-auto mb-14 max-w-5xl text-center">
      <span
        class="mb-4 inline-flex rounded-full bg-[#F4B400]/15 px-5 py-2 text-sm font-semibold text-[#F4B400]"
      >
        Forklift Battery Pricing
      </span>

      <h2 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
        Refurbished Forklift Batteries You Can Count On
      </h2>

      <p class="mt-5 text-base leading-relaxed text-[#CFE8D8] md:text-lg">
        High-quality refurbished forklift batteries professionally tested and
        backed by warranty. Find the right battery for your forklift and request
        a quote today.
      </p>
    </div>

    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
      {batteries.map((battery) => <CardPrecioBaterias {...battery} />)}
    </div>

    <div
      data-reveal
      class="mt-14 flex flex-wrap items-center justify-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm"
    >
      {
        benefits.map((benefit) => (
          <div class="flex items-center gap-2 text-sm font-semibold text-[#F5F5F4] md:text-base">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#F4B400] text-xs font-black text-black">
              ✓
            </span>
            {benefit}
          </div>
        ))
      }
    </div>
  </div>
</section>
