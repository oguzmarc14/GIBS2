---
const contactPhone = "+1 (714) 273-7944";
const contactPhoneHref = "tel:+17142737944";
const whatsappNumber = "17142737944";
const whatsappMessage = "Hello GIBS, I want to contact you about services and batteries.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section id="contactame" class="relative w-full overflow-hidden bg-gradient-to-b from-[#0b3b22] via-[#145a35] to-[#0b3b22]">
  <div class="pointer-events-none absolute top-8 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-emerald-400/20 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-12 text-center">
    <section class="mx-auto max-w-3xl rounded-2xl border border-emerald-200/20 bg-white/6 px-5 py-6 shadow-[0_16px_35px_rgba(0,0,0,0.35)] backdrop-blur-sm">
      <p class="text-sm font-semibold tracking-[0.24em] text-[#A7F3D0] uppercase">Contact Us</p>
      <h4 class="mt-2 text-2xl font-bold text-[#F5F5F4]">We are ready to help you</h4>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-[#CFE8D8] sm:text-base">
        To buy batteries or request services, call us or send us a direct WhatsApp message.
      </p>
      <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={contactPhoneHref} class="inline-flex items-center justify-center rounded-full border border-emerald-200/30 bg-white/10 px-5 py-2.5 font-semibold text-[#E8F5E9] transition-colors duration-300 hover:bg-white/20">
          {contactPhone}
        </a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full bg-[#F4B400] px-5 py-2.5 font-semibold text-black shadow-[0_8px_25px_rgba(244,180,0,0.25)] transition-all duration-300 hover:scale-105 hover:bg-[#d99d00]">
          Send Message
        </a>
      </div>
      <a href="/contacto" class="mt-4 inline-block text-sm font-semibold text-[#A7F3D0] transition-colors duration-300 hover:text-[#F4B400]">
        Go to full contact page
      </a>
    </section>
  </div>
</section>
