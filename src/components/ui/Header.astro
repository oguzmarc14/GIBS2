---
interface Props {
  h1Title: string;
  description: string;
}

const { h1Title, description } = Astro.props as Props;
---

<header
  class:list={[
    "relative",
    "overflow-hidden",
    "w-full",
    "px-4",
    "py-6",
    "md:px-8",
    "bg-gradient-to-b",
    "from-green-950",
    "via-green-900",
    "to-green-950",
    "border",
    "backdrop-blur-xl",
    "shadow-[0_16px_40px_rgba(12,74,47,0.28)]",
  ]}
>
  <div
    class="pointer-events-none absolute -top-20 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-emerald-200/35 blur-3xl"
  >
  </div>

  <div
    class="relative z-10 grid w-full grid-cols-[auto_1fr_auto] items-center justify-items-center gap-2 sm:gap-4 md:gap-6"
  >
    <img
      src="/logo.png"
      alt="Logo"
      class:list={[
        "justify-self-start",
        "sm:w-24",
        "sm:h-24",
        "md:w-28",
        "md:h-28",
        "lg:w-32",
        "lg:h-32",
        "w-20",
        "h-20",
        "xl:h-32",
        "hover:scale-110",
        "duration-300",
      ]}
    />

    <div class:list={["w-full"]}>
      <div
        class:list={["relative", "z-20", "mb-4", "mx-auto", "w-5/7"]}
      >
        <slot />
      </div>
      <h3
      class:list={[
        "text-white",
        "border",
        "border-green-200",
        "bg-green-900/25",
        "backdrop-blur-sm",
        "rounded-2xl",
        "px-2",
        "mt-8",
        "sm:px-2",
        "py-1.5",
        "text-[10px]",
        "sm:text-sm",
        "md:text-base",
        "lg:text-sm",
        "w-fit",
        "max-w-[13rem]",
        "sm:max-w-xs",
        "md:max-w-md",
        "lg:max-w-sm",
        "text-center",
        "uppercase",
        "tracking-wide",
        "leading-tight",
        "justify-self-center",
        "hover:shadow-2xl",
        "hover:shadow-amber-200",
        "hover:duration-300"
      ]}
    >
      {description}
    </h3>
    </div>

    <h1
      class="inline-flex hover:scale-110 duration-300 items-end justify-self-center xl:justify-self-end xl:translate-x-1 2xl:translate-x-2 text-2xl min-[500px]:text-[2.6rem] min-[980px]:text-[3.2rem] min-[1201px]:text-[3.5rem] min-[1536px]:text-[4rem] font-extrabold text-white leading-tight drop-shadow-md"
    >
      <span>{h1Title}</span>
      <span
        class="inline-flex -translate-y-1 min-[980px]:-translate-y-1.5 w-8 h-8 min-[500px]:w-11 min-[500px]:h-11 min-[980px]:w-12 min-[980px]:h-12 min-[1201px]:w-14 min-[1201px]:h-14 min-[1536px]:w-16 min-[1536px]:h-16 text-amber-300 lightning-wrap"
      >
        <svg
          class="h-full w-full lightning-bolt"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M13.2 1 5.6 13h4.8L8.8 23 18.4 9h-4.7L13.2 1Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </h1>
  </div>
</header>

<style>
  .lightning-wrap {
    animation: lightningAura 1.05s ease-in-out infinite;
  }

  .lightning-bolt {
    animation: lightningFlash 1.05s ease-in-out infinite;
    transform-origin: center;
    will-change: filter, opacity, transform;
  }

  @keyframes lightningFlash {
    0%,
    100% {
      opacity: 0.98;
      transform: scale(0.98) rotate(-1deg);
      filter: drop-shadow(0 0 14px rgba(253, 224, 71, 0.9))
        drop-shadow(0 0 28px rgba(251, 191, 36, 0.7));
    }

    30% {
      opacity: 1;
      transform: scale(1.03) rotate(0deg);
      filter: drop-shadow(0 0 20px rgba(253, 224, 71, 1))
        drop-shadow(0 0 38px rgba(251, 191, 36, 0.85));
    }

    55% {
      opacity: 1;
      transform: scale(1.07) rotate(1deg);
      filter: drop-shadow(0 0 32px rgba(253, 224, 71, 1))
        drop-shadow(0 0 52px rgba(251, 191, 36, 0.95));
    }

    78% {
      opacity: 1;
      transform: scale(1.02) rotate(0deg);
      filter: drop-shadow(0 0 24px rgba(253, 224, 71, 1))
        drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));
    }
  }

  @keyframes lightningAura {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(253, 224, 71, 0.95),
        0 0 26px rgba(251, 191, 36, 0.75),
        0 0 44px rgba(251, 191, 36, 0.45);
    }

    48% {
      text-shadow:
        0 0 18px rgba(253, 224, 71, 1),
        0 0 40px rgba(251, 191, 36, 0.9),
        0 0 66px rgba(251, 191, 36, 0.65);
    }
  }
</style>
