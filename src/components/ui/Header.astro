---
interface Props {
  h1Title: string;
  description: string;
  theme?: "dark" | "light";
}

const { h1Title, description, theme = "dark" } = Astro.props as Props;
const isLight = theme === "light";
---

<header
  class:list={[
    "relative",
    "z-40",
    "overflow-hidden",
    "w-full",
    "px-4",
    "py-3",
    "sm:py-6",
    "md:px-8",
    "bg-gradient-to-b",
    isLight ? "from-[#0F3D2E]" : "from-[#0F3D2E]",
    isLight ? "via-[#0B2A21]" : "via-[#0B2A21]",
    isLight ? "to-[#0F3D2E]" : "to-[#0F3D2E]",
    "border",
    isLight ? "border-white/12" : "border-white/12",
    "backdrop-blur-xl",
    isLight ? "shadow-[0_16px_40px_rgba(0,0,0,0.35),0_0_40px_rgba(31,122,92,0.4)]" : "shadow-[0_16px_40px_rgba(0,0,0,0.35),0_0_40px_rgba(31,122,92,0.4)]",
  ]}
>
  <div
    class:list={[
      "pointer-events-none",
      "absolute",
      "-top-20",
      "left-1/2",
      "h-64",
      "w-64",
      "-translate-x-1/2",
      "rounded-full",
      "blur-3xl",
      isLight ? "bg-[#1F7A5C]/18" : "bg-[#1F7A5C]/18",
    ]}
  >
  </div>

  <div
    class="relative z-10 grid w-full grid-cols-[1fr_auto_1fr] items-center justify-items-center gap-3 sm:gap-4 md:gap-6"
  >
    <a href="/" aria-label="Go to homepage" class="order-1 justify-self-start">
      <img
        src="/logo.png"
        alt="GIBS Logo"
        class:list={[
          "w-20",
          "h-20",
          "sm:w-20",
          "sm:h-20",
          "md:w-24",
          "md:h-24",
          "lg:w-28",
          "lg:h-28",
          "xl:h-28",
          "shrink-0",
          "hover:scale-110",
          "duration-300",
          "md:ml-0"
        ]}
      />
    </a>

    <div class:list={["order-2", "w-auto"]}>
      <div
        class:list={["relative", "z-20", "h-16", "mb-3", "mx-auto", "w-full", "xl:w-5/7"]}
      >
        <slot />
      </div>
      <h3
      class:list={[
        isLight ? "text-[#CFE8D8]" : "text-[#CFE8D8]",
        "border",
        isLight ? "border-white/20" : "border-white/20",
        isLight ? "bg-white/5" : "bg-white/5",
        "backdrop-blur-sm",
        "rounded-full",
        "px-3",
        "mt-3",
        "md:mt-6",
        "sm:px-2",
        "py-1.5",
        "text-[10px]",
        "sm:text-sm",
        "md:text-base",
        "lg:text-sm",
        "w-fit",
        "max-w-[13rem]",
        "sm:max-w-xs",
        "md:max-w-md",
        "lg:max-w-sm",
        "text-center",
        "mx-auto",
        "uppercase",
        "tracking-wide",
        "leading-tight",
        "justify-self-center",
        "shadow-[0_8px_24px_rgba(0,0,0,0.28),0_0_25px_rgba(31,122,92,0.5)]",
        "hover:shadow-2xl",
        isLight ? "hover:shadow-[0_0_30px_rgba(31,122,92,0.35)]" : "hover:shadow-[0_0_30px_rgba(31,122,92,0.35)]",
        "hover:duration-400",
        "hover:scale-105"
      ]}
    >
      {description}
    </h3>
    </div>

    <h1
      class:list={[
        "order-3",
        "inline-flex",
        "hover:scale-110",
        "duration-300",
        "items-end",
        "justify-self-end",
        "md:translate-x-0",
        "xl:translate-x-1",
        "2xl:translate-x-2",
        "text-[1.55rem]",
        "min-[500px]:text-[2.0rem]",
        "min-[980px]:text-[2.7rem]",
        "min-[1100px]:text-[3.2rem]",
        "min-[1201px]:text-[3.5rem]",
        "min-[1536px]:text-[4rem]",
        "font-extrabold",
        isLight ? "text-[#E8F5E9]" : "text-[#E8F5E9]",
        "leading-tight",
        "drop-shadow-[0_2px_10px_rgba(0,0,0,0.35)]",
      ]}
    >
      <span>{h1Title}</span>
      <span
        class="inline-flex -translate-y-1 min-[980px]:-translate-y-1.5 w-8 h-8 min-[500px]:w-11 min-[500px]:h-11 min-[980px]:w-12 min-[980px]:h-12 min-[1201px]:w-14 min-[1201px]:h-14 min-[1536px]:w-16 min-[1536px]:h-16 text-amber-300 lightning-wrap"
      >
        <svg
          class="h-full w-full lightning-bolt"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M13.2 1 5.6 13h4.8L8.8 23 18.4 9h-4.7L13.2 1Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </h1>
  </div>
</header>

<style>
  .lightning-wrap {
    animation: lightningAura 1.05s ease-in-out infinite;
  }

  .lightning-bolt {
    animation: lightningFlash 1.05s ease-in-out infinite;
    transform-origin: center;
    will-change: filter, opacity, transform;
  }

  @keyframes lightningFlash {
    0%,
    100% {
      opacity: 0.98;
      transform: scale(0.98) rotate(-1deg);
      filter: drop-shadow(0 0 14px rgba(253, 224, 71, 0.9))
        drop-shadow(0 0 28px rgba(251, 191, 36, 0.7));
    }

    30% {
      opacity: 1;
      transform: scale(1.03) rotate(0deg);
      filter: drop-shadow(0 0 20px rgba(253, 224, 71, 1))
        drop-shadow(0 0 38px rgba(251, 191, 36, 0.85));
    }

    55% {
      opacity: 1;
      transform: scale(1.07) rotate(1deg);
      filter: drop-shadow(0 0 32px rgba(253, 224, 71, 1))
        drop-shadow(0 0 52px rgba(251, 191, 36, 0.95));
    }

    78% {
      opacity: 1;
      transform: scale(1.02) rotate(0deg);
      filter: drop-shadow(0 0 24px rgba(253, 224, 71, 1))
        drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));
    }
  }

  @keyframes lightningAura {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(253, 224, 71, 0.95),
        0 0 26px rgba(251, 191, 36, 0.75),
        0 0 44px rgba(251, 191, 36, 0.45);
    }

    48% {
      text-shadow:
        0 0 18px rgba(253, 224, 71, 1),
        0 0 40px rgba(251, 191, 36, 0.9),
        0 0 66px rgba(251, 191, 36, 0.65);
    }
  }
</style>
