---
interface Props {
  h1Title: string;
  h2Title: string;
  slogan: string;
}

const { h1Title, h2Title, slogan } = Astro.props as Props;
---

<div
  class:list={[
    "relative",
    "place-items-center",
    "text-center",
    "h-104",
    "grid",
    "bg-gradient-to-br",
    "from-[#07702b]",
    "via-[#022E0B]",
    "to-[#054b3c]",
    "backdrop-brightness-75",
  ]}
>
  <!-- Contenido -->
  <div class="relative grid grid-cols-2 items-center max-w-6xl w-full gap-2">
    <!-- Logo -->
    <img src="/logo.png" alt="Logo" class="w-96 h-96 mx-auto md:ml-12" />
    <!-- Texto -->
    <div>
      <div class="mb-4">
        <span
          class="block h-[8px] w-84 md:w-[32rem] bg-gradient-to-r from-transparent via-amber-300 to-transparent"
        ></span>
      </div>
      <h1
        class="inline-flex items-end text-5xl md:text-9xl font-extrabold text-white leading-tight drop-shadow-md"
      >
        <span>{h1Title}</span>
        <span class="inline-flex w-32 h-36 text-amber-300 lightning-wrap">
          <svg class="h-full w-full lightning-bolt" viewBox="0 0 24 24" fill="none">
            <path
              d="M13.2 1 5.6 13h4.8L8.8 23 18.4 9h-4.7L13.2 1Z"
              fill="currentColor"></path>
          </svg>
        </span>
      </h1>
      <h2 class="lg:text-3xl md:text-3xl text-white/90 mt-6 -ml-8">
        {h2Title}
      </h2>
      <p class="text-lg text-white/80 mt-2 -ml-14">{slogan}</p>
    </div>
  </div>
</div>

<style>
  .lightning-wrap {
    animation: lightningAura 1.05s ease-in-out infinite;
  }

  .lightning-bolt {
    animation: lightningFlash 1.05s ease-in-out infinite;
    transform-origin: center;
    will-change: filter, opacity, transform;
  }

  @keyframes lightningFlash {
    0%,
    100% {
      opacity: 0.98;
      transform: scale(0.98) rotate(-1deg);
      filter:
        drop-shadow(0 0 14px rgba(253, 224, 71, 0.9))
        drop-shadow(0 0 28px rgba(251, 191, 36, 0.7));
    }

    30% {
      opacity: 1;
      transform: scale(1.03) rotate(0deg);
      filter:
        drop-shadow(0 0 20px rgba(253, 224, 71, 1))
        drop-shadow(0 0 38px rgba(251, 191, 36, 0.85));
    }

    55% {
      opacity: 1;
      transform: scale(1.07) rotate(1deg);
      filter:
        drop-shadow(0 0 32px rgba(253, 224, 71, 1))
        drop-shadow(0 0 52px rgba(251, 191, 36, 0.95));
    }

    78% {
      opacity: 1;
      transform: scale(1.02) rotate(0deg);
      filter:
        drop-shadow(0 0 24px rgba(253, 224, 71, 1))
        drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));
    }
  }

  @keyframes lightningAura {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(253, 224, 71, 0.95),
        0 0 26px rgba(251, 191, 36, 0.75),
        0 0 44px rgba(251, 191, 36, 0.45);
    }

    48% {
      text-shadow:
        0 0 18px rgba(253, 224, 71, 1),
        0 0 40px rgba(251, 191, 36, 0.9),
        0 0 66px rgba(251, 191, 36, 0.65);
    }
  }
</style>
