---
interface Props {
  h1Title: string;
  h2Title: string;
  description: string;
}

const { h1Title, description } = Astro.props as Props;
---

<header
  class:list={[
    "relative",
    "overflow-hidden",
    "flex",
    "flex-col",
    "md:flex-row",
    "items-center",
    "justify-center",
    "md:justify-between",
    "gap-4",
    "md:gap-8",
    "w-full",
    "px-4",
    "py-6",
    "md:px-8",
    "bg-gradient-to-br",
    "from-[#052714]",
    "via-[#031d0f]",
    "to-[#041a15]",
  ]}
>
  <div class="pointer-events-none absolute -top-16 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-emerald-300/15 blur-3xl"></div>

  <img
    src="/logo.png"
    alt="Logo"
    class:list={["order-2", "md:order-1", "relative", "z-10", "w-28", "h-28", "sm:w-36", "sm:h-36", "md:w-44", "md:h-44"]}
  />

  <h3
    class:list={[
      "order-1",
      "md:order-2",
      "relative",
      "z-10",
      "text-white",
      "border",
      "border-emerald-200/45",
      "bg-white/8",
      "backdrop-blur-sm",
      "rounded-2xl",
      "px-4",
      "py-2",
      "text-xs",
      "sm:text-sm",
      "md:text-base",
      "max-w-xs",
      "hover:scale-105",
      "duration-200",
      "text-center",
      "uppercase",
      "tracking-wide"
    ]}
  >
    {description}
  </h3>

  <div class="order-3 md:order-3 relative z-10 flex flex-col items-center text-center md:text-left md:items-end">
    <h1
      class="inline-flex items-end text-3xl sm:text-4xl md:text-6xl font-extrabold text-white leading-tight drop-shadow-md"
    >
      <span>{h1Title}</span>
      <span class="inline-flex w-14 h-14 sm:w-18 sm:h-18 md:w-22 md:h-22 text-amber-300 lightning-wrap">
        <svg
          class="h-full w-full lightning-bolt"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M13.2 1 5.6 13h4.8L8.8 23 18.4 9h-4.7L13.2 1Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </h1>
  </div>
</header>

<style>
  .lightning-wrap {
    animation: lightningAura 1.05s ease-in-out infinite;
  }

  .lightning-bolt {
    animation: lightningFlash 1.05s ease-in-out infinite;
    transform-origin: center;
    will-change: filter, opacity, transform;
  }

  @keyframes lightningFlash {
    0%,
    100% {
      opacity: 0.98;
      transform: scale(0.98) rotate(-1deg);
      filter: drop-shadow(0 0 14px rgba(253, 224, 71, 0.9))
        drop-shadow(0 0 28px rgba(251, 191, 36, 0.7));
    }

    30% {
      opacity: 1;
      transform: scale(1.03) rotate(0deg);
      filter: drop-shadow(0 0 20px rgba(253, 224, 71, 1))
        drop-shadow(0 0 38px rgba(251, 191, 36, 0.85));
    }

    55% {
      opacity: 1;
      transform: scale(1.07) rotate(1deg);
      filter: drop-shadow(0 0 32px rgba(253, 224, 71, 1))
        drop-shadow(0 0 52px rgba(251, 191, 36, 0.95));
    }

    78% {
      opacity: 1;
      transform: scale(1.02) rotate(0deg);
      filter: drop-shadow(0 0 24px rgba(253, 224, 71, 1))
        drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));
    }
  }

  @keyframes lightningAura {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(253, 224, 71, 0.95),
        0 0 26px rgba(251, 191, 36, 0.75),
        0 0 44px rgba(251, 191, 36, 0.45);
    }

    48% {
      text-shadow:
        0 0 18px rgba(253, 224, 71, 1),
        0 0 40px rgba(251, 191, 36, 0.9),
        0 0 66px rgba(251, 191, 36, 0.65);
    }
  }
</style>
