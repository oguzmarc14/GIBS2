---
interface Props {
  h1Title: string;
  description: string;
  theme?: "dark" | "light";
}

const { h1Title, description, theme = "dark" } = Astro.props as Props;
const isLight = theme === "light";
---

<header
  class:list={[
    "relative",
    "sticky",
    "top-0",
    "z-50",
    "overflow-hidden",
    "w-full",
    "px-4",
    "py-3",
    "sm:py-5",
    "md:px-8",
    "bg-gradient-to-b",
    isLight ? "from-white" : "from-[#1b261d]",
    isLight ? "via-[#f2f0e8]" : "via-[#243225]",
    isLight ? "to-white" : "to-[#2d261b]",
    "border",
    isLight ? "border-emerald-900/25" : "border-emerald-200/35",
    "backdrop-blur-xl",
    isLight ? "shadow-[0_16px_40px_rgba(24,34,22,0.22)]" : "shadow-[0_16px_40px_rgba(8,20,12,0.45)]",
  ]}
>
  <div
    class:list={[
      "pointer-events-none",
      "absolute",
      "-top-20",
      "left-1/2",
      "h-64",
      "w-64",
      "-translate-x-1/2",
      "rounded-full",
      "blur-3xl",
      isLight ? "bg-[#32412f]/20" : "bg-emerald-500/20",
    ]}
  >
  </div>

  <div
    class="relative z-10 grid w-full grid-cols-1 items-center justify-items-center gap-3 sm:gap-4 md:grid-cols-[auto_1fr_auto] md:gap-6"
  >
    <img
      src="/logo.png"
      alt="Logo"
      class:list={[
        "order-1",
        "justify-self-center",
        "md:justify-self-start",
        "w-16",
        "h-16",
        "sm:w-20",
        "sm:h-20",
        "md:w-24",
        "md:h-24",
        "lg:w-28",
        "lg:h-28",
        "xl:h-28",
        "shrink-0",
        "hover:scale-110",
        "duration-300",
        "md:ml-0"
      ]}
    />

    <div class:list={["order-3", "md:order-2", "w-full", "max-w-4xl"]}>
      <div
        class:list={["relative", "z-20", "mb-3", "md:mb-4", "mx-auto", "w-full", "md:w-full", "xl:w-5/7"]}
      >
        <slot />
      </div>
      <h3
      class:list={[
        isLight ? "text-[#2e3b2b]" : "text-emerald-50",
        "border",
        isLight ? "border-[#32412f]/40" : "border-emerald-200/45",
        isLight ? "bg-white/75" : "bg-black/25",
        "backdrop-blur-sm",
        "rounded-2xl",
        "px-3",
        "mt-4",
        "md:mt-8",
        "sm:px-2",
        "py-1.5",
        "text-[10px]",
        "sm:text-sm",
        "md:text-base",
        "lg:text-sm",
        "w-fit",
        "max-w-[13rem]",
        "sm:max-w-xs",
        "md:max-w-md",
        "lg:max-w-sm",
        "text-center",
        "mx-auto",
        "uppercase",
        "tracking-wide",
        "leading-tight",
        "justify-self-center",
        "hover:shadow-2xl",
        isLight ? "hover:shadow-[#32412f]/35" : "hover:shadow-emerald-800/70",
        "hover:duration-300"
      ]}
    >
      {description}
    </h3>
    </div>

    <h1
      class:list={[
        "order-2",
        "md:order-3",
        "inline-flex",
        "hover:scale-110",
        "duration-300",
        "items-end",
        "justify-self-center",
        "md:justify-self-end",
        "md:translate-x-0",
        "xl:translate-x-1",
        "2xl:translate-x-2",
        "text-[1.8rem]",
        "min-[500px]:text-[2.2rem]",
        "min-[980px]:text-[2.7rem]",
        "min-[1100px]:text-[3.2rem]",
        "min-[1201px]:text-[3.5rem]",
        "min-[1536px]:text-[4rem]",
        "font-extrabold",
        isLight ? "text-[#32412f]" : "text-emerald-200",
        "leading-tight",
        "drop-shadow-md",
      ]}
    >
      <span>{h1Title}</span>
      <span
        class="inline-flex -translate-y-1 min-[980px]:-translate-y-1.5 w-8 h-8 min-[500px]:w-11 min-[500px]:h-11 min-[980px]:w-12 min-[980px]:h-12 min-[1201px]:w-14 min-[1201px]:h-14 min-[1536px]:w-16 min-[1536px]:h-16 text-amber-300 lightning-wrap"
      >
        <svg
          class="h-full w-full lightning-bolt"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M13.2 1 5.6 13h4.8L8.8 23 18.4 9h-4.7L13.2 1Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </h1>
  </div>
</header>

<style>
  .lightning-wrap {
    animation: lightningAura 1.05s ease-in-out infinite;
  }

  .lightning-bolt {
    animation: lightningFlash 1.05s ease-in-out infinite;
    transform-origin: center;
    will-change: filter, opacity, transform;
  }

  @keyframes lightningFlash {
    0%,
    100% {
      opacity: 0.98;
      transform: scale(0.98) rotate(-1deg);
      filter: drop-shadow(0 0 14px rgba(253, 224, 71, 0.9))
        drop-shadow(0 0 28px rgba(251, 191, 36, 0.7));
    }

    30% {
      opacity: 1;
      transform: scale(1.03) rotate(0deg);
      filter: drop-shadow(0 0 20px rgba(253, 224, 71, 1))
        drop-shadow(0 0 38px rgba(251, 191, 36, 0.85));
    }

    55% {
      opacity: 1;
      transform: scale(1.07) rotate(1deg);
      filter: drop-shadow(0 0 32px rgba(253, 224, 71, 1))
        drop-shadow(0 0 52px rgba(251, 191, 36, 0.95));
    }

    78% {
      opacity: 1;
      transform: scale(1.02) rotate(0deg);
      filter: drop-shadow(0 0 24px rgba(253, 224, 71, 1))
        drop-shadow(0 0 44px rgba(251, 191, 36, 0.9));
    }
  }

  @keyframes lightningAura {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(253, 224, 71, 0.95),
        0 0 26px rgba(251, 191, 36, 0.75),
        0 0 44px rgba(251, 191, 36, 0.45);
    }

    48% {
      text-shadow:
        0 0 18px rgba(253, 224, 71, 1),
        0 0 40px rgba(251, 191, 36, 0.9),
        0 0 66px rgba(251, 191, 36, 0.65);
    }
  }
</style>
