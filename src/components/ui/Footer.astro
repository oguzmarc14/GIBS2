---
interface Props {
  companyName?: string;
}

const { companyName = "GIBS" } = Astro.props as Props;
---

<footer class="relative overflow-hidden bg-gradient-to-br from-[#052714] via-[#031d0f] to-[#041a15] text-emerald-50">
  <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-emerald-300/15 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-14 text-center">
    <div class="grid gap-10 md:grid-cols-3">
      <section class="flex flex-col items-center">
        <h3 class="text-2xl font-extrabold tracking-wide text-white">{companyName}</h3>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-emerald-100/85">
          Industrial battery maintenance, repairs and charging solutions with reliable support for your operation.
        </p>
      </section>

      <section class="flex flex-col items-center">
        <h4 class="text-sm font-bold tracking-[0.2em] text-emerald-200 uppercase">Quick Links</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="#" class="transition hover:text-white">Home</a></li>
          <li><a href="#services" class="transition hover:text-white">Services</a></li>
          <li><a href="#" class="transition hover:text-white">Chargers</a></li>
          <li><a href="#" class="transition hover:text-white">Contact</a></li>
        </ul>
      </section>

      <section class="flex flex-col items-center">
        <h4 class="text-sm font-bold tracking-[0.2em] text-emerald-200 uppercase">Contact</h4>
        <ul class="mt-4 space-y-2 text-sm text-emerald-100/85">
          <li>Email: info@gibs.com</li>
          <li>Phone: +1 (555) 123-4567</li>
          <li>Mon - Fri: 8:00 AM - 6:00 PM</li>
        </ul>
      </section>
    </div>

    <div class="mt-10 border-t border-emerald-200/20 pt-5 text-center text-xs text-emerald-100/75">
      <p>© {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      <p class="mt-2 text-emerald-100/90">Creado por Marco Webs Studio</p>
    </div>
  </div>
</footer>
