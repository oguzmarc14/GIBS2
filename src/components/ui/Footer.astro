---
interface Props {
  companyName?: string;
}

const { companyName = "GIBS" } = Astro.props as Props;
---

<footer class="relative overflow-hidden bg-gradient-to-b from-[#0F3D2E] via-[#0B2A21] to-[#0B2A21] text-[#E8F5E9] border-t border-white/10">
  <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-[#1F7A5C]/20 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-14 text-center">
    <div class="grid gap-10 md:grid-cols-3">
      <section class="flex flex-col items-center">
        <h3 class="text-2xl font-extrabold tracking-wide text-[#F5F5F4] drop-shadow-[0_2px_10px_rgba(0,0,0,0.35)]">{companyName}</h3>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#CFE8D8]">
          Industrial battery maintenance, repairs and charging solutions with reliable support for your operation.
        </p>
      </section>

      <section class="flex flex-col items-center">
        <h4 class="text-sm font-bold tracking-[0.25em] text-[#A7F3D0] uppercase">Quick Links</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="#" class="transition-colors duration-300 hover:text-[#F4B400]">Home</a></li>
          <li><a href="#services" class="transition-colors duration-300 hover:text-[#F4B400]">Services</a></li>
          <li><a href="#" class="transition-colors duration-300 hover:text-[#F4B400]">Chargers</a></li>
          <li><a href="#" class="transition-colors duration-300 hover:text-[#F4B400]">Contact</a></li>
        </ul>
      </section>

      <section class="flex flex-col items-center">
        <h4 class="text-sm font-bold tracking-[0.25em] text-[#A7F3D0] uppercase">Contact</h4>
        <ul class="mt-4 space-y-2 text-sm text-[#CFE8D8]">
          <li>Email: info@gibs.com</li>
          <li>Phone: +1 (555) 123-4567</li>
          <li>Mon - Fri: 8:00 AM - 6:00 PM</li>
        </ul>
      </section>
    </div>

    <div class="mt-10 border-t border-white/12 pt-5 text-center text-xs text-[#CFE8D8]/90">
      <p>© {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      <p class="mt-2 text-[#A7F3D0]">Created by Marco Webs Studio</p>
    </div>
  </div>
</footer>
