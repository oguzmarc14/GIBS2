---
interface Props {
  text: string;
  href: string;
  isGhost: boolean;
  class?: string;
}

const { href, isGhost = false, text, class: className = "" } = Astro.props as Props;
---

<a
    href={href}
    class:list={[
    "text-sm",
    "font-semibold",
    "w-44 md:w-48",
    "py-3.5",
    "text-center",
    "rounded-full",
    "duration-300",
    "border",
    "shadow-[0_10px_24px_rgba(0,0,0,0.15)]",
    "tracking-[0.06em]",
    className,
    isGhost ? "bg-[#ffb347] text-[#072530] border-[#ffb347]" : "bg-transparent text-white border-white/70",
    isGhost ? "hover:bg-[#ffc676] hover:scale-[1.04]" : "hover:bg-white hover:text-[#073340] hover:border-white hover:scale-[1.04]",
  ]}
>
  {text}
  </a>
