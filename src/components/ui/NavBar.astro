---
interface Props {
  option1: string;
  option2: string;
  option3: string;
  option4: string;
  option5?: string;
  href1: string;
  href2: string;
  href3: string;
  href4: string;
  href5?: string;
}

const {
  option1,
  option2,
  option3,
  option4,
  option5,
  href1,
  href2,
  href3,
  href4,
  href5,
} = Astro.props as Props;
---

<nav>
  <ul
    class:list={[
      "flex",
      "justify-center",
      "items-center",
      "sm:w-6/9",
      "w-6/7",
      "mx-auto",
      "gap-1",
      "py-2",
      "px-2",
      "rounded-full",
      "border",
      "border-green-200/70",
      "bg-green-500/25",
      "backdrop-blur-md",
      "shadow-[0_8px_22px_rgba(15,60,35,0.2)]",
      "overflow-x-auto",
      "whitespace-nowrap",
      "[scrollbar-width:none]",
      "[-ms-overflow-style:none]",
      "[&::-webkit-scrollbar]:hidden",
      "hover:bg-green-900/40",
      "hover:scale-105",
      "duration-300"

    ]}
  >
    <li class="relative group px-2 border-l border-r border-green-200/80">
      <a href={href1} class="text-base font-semibold text-white transition duration-300 group-hover:text-green-950">
        {option1}
        <span class="block h-0.5 w-0 bg-green-800 transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group px-2 border-l border-r border-green-200/80">
      <a href={href2} class="text-base font-semibold text-white transition duration-300 group-hover:text-green-950">
        {option2}
        <span class="block h-0.5 w-0 bg-green-800 transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group px-2 border-l border-r border-green-200/80">
      <a href={href3} class="text-base font-semibold text-white transition duration-300 group-hover:text-green-950">
        {option3}
        <span class="block h-0.5 w-0 bg-green-800 transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group px-2 border-l border-r border-green-200/80">
      <a href={href4} class="text-base font-semibold text-white transition duration-300 group-hover:text-green-950">
        {option4}
        <span class="block h-0.5 w-0 bg-green-800 transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    {option5 && (
    <li class="relative group px-2 border-l border-green-200/80">
      <a href={href5} class="text-base font-semibold text-whites transition duration-300 group-hover:text-green-700">
        {option5}
        <span class="block h-0.5 w-0 bg-green-800 transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    )}
  </ul>
</nav>


