---
interface Props {
  option1: string;
  option2: string;
  option3: string;
  option4: string;
  option5: string;
}

const { option1, option2, option3, option4, option5 } = Astro.props as Props;
---

<nav>
  <ul
    class:list={[
      "flex",
      "justify-center",
      "items-center",
      "w-full",
      "flex-wrap",
      "gap-4 md:gap-9",
      "bg-white/82",
      "backdrop-blur-md",
      "font-semibold",
      "text-slate-800",
      "shadow-[0_14px_30px_rgba(6,44,58,0.14)]",
      "h-auto min-h-16",
      "px-5 py-3",
      "text-sm md:text-base",
      "tracking-[0.1em]",
      "border-y border-slate-200/70",
      "uppercase",
    ]}
  >
    <li class="relative group">
      <a href="/" class="transition duration-300 group-hover:text-[#0c6f56]">
        {option1}
        <span class="block h-0.5 w-0 bg-[#30b5ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group">
      <a href="/services" class="transition duration-300 group-hover:text-[#0c6f56]">
        {option2}
        <span class="block h-0.5 w-0 bg-[#30b5ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group">
      <a href="/chargerss" class="transition duration-300 group-hover:text-[#0c6f56]">
        {option3}
        <span class="block h-0.5 w-0 bg-[#30b5ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group">
      <a href="/marco" class="transition duration-300 group-hover:text-[#0c6f56]">
        {option4}
        <span class="block h-0.5 w-0 bg-[#30b5ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
    <li class="relative group">
      <a href="/services" class="transition duration-300 group-hover:text-[#0c6f56]">
        {option5}
        <span class="block h-0.5 w-0 bg-[#30b5ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </li>
  </ul>
</nav>


