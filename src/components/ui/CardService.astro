---
interface Props {
  titulo: string;
  descripcion: string;
  imgSrc?: string;
  imgAlt?: string;
  ctaText?: string;
  whatsappMessagePrefix?: string;
}

const { titulo, descripcion, imgSrc, imgAlt, ctaText, whatsappMessagePrefix } =
  Astro.props as Props;

const finalCtaText = ctaText ?? "I'm interested in this service";
const finalWhatsappPrefix =
  whatsappMessagePrefix ?? "I'm interested in this service";
const whatsappNumber = "15626706851";
const whatsappMessage = `${finalWhatsappPrefix}: ${titulo}`;
const hrefWhatsapp = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<article
  class:list={[
    "flex",
    "flex-col",
    "bg-gradient-to-b",
    "from-green-800",
    "via-green-900",
    "to-green-800",
    "border",
    "border-green-700",
    "min-h-[34rem]",
    "sm:min-h-[38rem]",
    "md:min-h-[42rem]",
    "px-4",
    "pb-4",
    "pt-2",
    "w-full",
    "max-w-96",
    "rounded-2xl",
    "shadow-lg",
  ]}
>
  <h3
    class:list={[
      "bg-white",
      "p-2",
      "w-fit",
      "mx-auto",
      "rounded-2xl",
      "text-green-900",
      "-mt-6",
    ]}
  >
    {titulo}
  </h3>

  <p class:list={["mt-4", "min-h-28", "sm:min-h-36", "md:min-h-44", "px-2", "text-white", "text-sm", "leading-relaxed"]}>
    {descripcion}
  </p>

  {imgSrc && (
    <div class="h-48 sm:h-56 md:h-64 w-full overflow-hidden rounded-xl border border-white/20">
      <img
        src={imgSrc}
        alt={imgAlt ?? titulo}
        class:list={["h-full", "w-full", "object-cover"]}
      />
    </div>
  )}

  <a href={hrefWhatsapp} target="_blank" rel="noopener noreferrer" class:list={["mt-4", "text-green-950", "bg-white", "w-fit", "mx-auto", "px-3", "py-2.5", "sm:p-3", "rounded-2xl", "text-sm", "sm:text-base"]}>
    {finalCtaText}
  </a>
</article>
