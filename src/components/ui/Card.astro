---
interface Props {
  h2Text: string;
  description: string;
  srcImage: string;
  srcDireccion: string;
}

const { h2Text, description, srcImage, srcDireccion } = Astro.props as Props;
---

<article data-reveal class:list={["relative", "h-full", "group", "w-full", "max-w-[22rem]"]}>
  <div
    class:list={[
      "flex",
      "flex-col",
      "h-full",
      "bg-[#145A35]/80",
      "backdrop-blur-sm",
      "w-full",
      "min-h-[31rem]",
      "p-7",
      "rounded-2xl",
      "border",
      "border-white/10",
      "shadow-[0_10px_30px_rgba(0,0,0,0.18)]",
      "relative",
      "transition-transform",
      "duration-300",
      "group-hover:-translate-y-1",
      "group-hover:shadow-[0_14px_40px_rgba(0,0,0,0.25)]",
    ]}
  >
    <h2 class:list={["mb-3", "text-2xl", "text-[#F5F5F4]", "font-bold", "leading-snug", "drop-shadow-[0_2px_10px_rgba(0,0,0,0.35)]"]}>{h2Text}</h2>
    <p class:list={["text-[#CFE8D8]", "leading-relaxed", "text-sm", "md:text-base"]}>{description}</p>
    <div class="mt-6 overflow-hidden rounded-2xl border border-white/15">
      <img
        src={srcImage}
        alt={h2Text}
        class:list={["h-44", "w-full", "object-cover", "transition-transform", "duration-500", "group-hover:scale-105"]}
      />
    </div>
    <a
      href={srcDireccion}
      class:list={[
        "inline-flex",
        "items-center",
        "justify-center",
        "mx-auto",
        "mt-auto",
        "pt-2",
        "px-6",
        "py-3",
        "rounded-xl",
        "bg-[#F4B400]",
        "text-black",
        "font-semibold",
        "tracking-wide",
        "shadow-[0_8px_25px_rgba(244,180,0,0.25)]",
        "hover:bg-[#d99d00]",
        "transition-all",
        "duration-300",
        "hover:scale-105",
      ]}
    >
      Learn more
    </a>
  </div>
</article>
