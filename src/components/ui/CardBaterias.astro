---
interface Props {
  titulo: string;
  modelo: string;
  voltaje: string;
  amperaje: string;
  rangoAh: string;
  imageSrc?: string;
  imageAlt?: string;
  categoria?: string;
  hrefCotizar?: string;
  ctaText?: string;
}

const {
  titulo,
  modelo,
  voltaje,
  amperaje,
  rangoAh,
  imageSrc,
  imageAlt,
  categoria = "PBM Single Phase",
  hrefCotizar,
  ctaText = "Get Quote",
} = Astro.props as Props;

const whatsappNumber = "15626706851";
const whatsappMessage = `Hello GIBS, I want a quote for ${titulo} (${modelo})`;
const hrefDefault = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const hrefFinal = hrefCotizar ?? hrefDefault;
---

<article
  data-reveal
  class:list={[
    "relative",
    "group",
    "flex",
    "flex-col",
    "h-full",
    "w-full",
    "max-w-[23rem]",
    "rounded-2xl",
    "border",
    "border-white/10",
    "bg-[#145A35]/80",
    "backdrop-blur-sm",
    "p-5",
    "shadow-[0_10px_30px_rgba(0,0,0,0.18)]",
    "transition-transform",
    "duration-300",
    "group-hover:-translate-y-1",
    "group-hover:shadow-[0_14px_40px_rgba(0,0,0,0.25)]",
  ]}
>
  <p
    class:list={[
      "mb-6",
      "w-fit",
      "mx-auto",
      "rounded-full",
      "border",
      "border-white/20",
      "bg-white/5",
      "px-3",
      "py-1",
      "text-xs",
      "font-semibold",
      "uppercase",
      "tracking-[0.16em]",
      "text-[#A7F3D0]",
    ]}
  >
    {categoria}
  </p>

  <h3
    class:list={[
      "text-[#F5F5F4]",
      "text-xl",
      "font-bold",
      "leading-snug",
      "sm:text-2xl",
      "mb-4",
    ]}
  >
    {titulo}
  </h3>
  <p class:list={["mt-1", "text-[#CFE8D8]", "text-sm"]}>Model: {modelo}</p>

  {imageSrc && (
    <div
      class:list={[
        "mt-5",
        "overflow-hidden",
        "rounded-2xl",
        "border",
        "border-white/15",
      ]}
    >
      <img
        src={imageSrc}
        alt={imageAlt ?? titulo}
        class:list={[
          "h-44",
          "w-full",
          "object-cover",
          "transition-transform",
          "duration-500",
          "group-hover:scale-105",
        ]}
      />
    </div>
  )}

  <ul
    class:list={[
      "mt-5",
      "space-y-2",
      "text-sm",
      "text-[#CFE8D8]",
      "leading-relaxed",
      "sm:text-base",
    ]}
  >
    <li
      class:list={[
        "flex",
        "items-center",
        "justify-between",
        "gap-3",
        "rounded-xl",
        "border",
        "border-white/10",
        "bg-black/10",
        "px-3",
        "py-2",
      ]}
    >
      <span class:list={["font-semibold", "text-[#E8F5E9]"]}>Voltage</span>
      <span>{voltaje}</span>
    </li>
    <li
      class:list={[
        "flex",
        "items-center",
        "justify-between",
        "gap-3",
        "rounded-xl",
        "border",
        "border-white/10",
        "bg-black/10",
        "px-3",
        "py-2",
      ]}
    >
      <span class:list={["font-semibold", "text-[#E8F5E9]"]}>Amperage</span>
      <span>{amperaje}</span>
    </li>
    <li
      class:list={[
        "flex",
        "items-center",
        "justify-between",
        "gap-3",
        "rounded-xl",
        "border",
        "border-white/10",
        "bg-black/10",
        "px-3",
        "py-2",
      ]}
    >
      <span class:list={["font-semibold", "text-[#E8F5E9]"]}>Battery Range</span>
      <span>{rangoAh} Ah</span>
    </li>
  </ul>

  <a
    href={hrefFinal}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "inline-flex",
      "items-center",
      "justify-center",
      "mx-auto",
      "mt-4",
      "pt-2",
      "px-6",
      "py-3",
      "rounded-xl",
      "bg-[#F4B400]",
      "text-black",
      "font-semibold",
      "tracking-wide",
      "shadow-[0_8px_25px_rgba(244,180,0,0.25)]",
      "hover:bg-[#d99d00]",
      "transition-all",
      "duration-300",
      "hover:scale-105",
      "text-sm",
      "sm:text-base",
    ]}
  >
    {ctaText}
  </a>
</article>
