---
import Button from "./Button.astro";

interface Props {
  h2Title: string;
  srcImage: string;
  description: string;
  textButton: string;
  href: string;
  class?: string;
  isGhost?: boolean;
}

const {
  h2Title,
  srcImage,
  description,
  textButton,
  href,
  class: className = "",
} = Astro.props as Props;
---

<article class:list={["relative overflow-hidden", className]}>
  <img
    class="h-[76vh] min-h-[30rem] w-full object-cover object-center"
    src={srcImage}
    alt="Imagen de batería"
  />

  <div class="absolute inset-0 bg-[linear-gradient(106deg,rgba(4,27,34,0.92)_0%,rgba(4,27,34,0.7)_44%,rgba(4,27,34,0.2)_100%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(48,181,255,0.22),transparent_35%)]"></div>

  <div
    class:list={[
      "absolute inset-0",
      "flex",
      "flex-col",
      "justify-center",
      "text-white",
      "text-left",
      "px-6 md:px-20",
      "w-full md:w-[64%]",
    ]}
  >
    <span class="mb-4 inline-flex w-fit items-center rounded-full border border-cyan-300/40 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-cyan-100 backdrop-blur-sm">
      Battery Recovery Lab
    </span>
    <h2 class="text-3xl font-bold leading-tight md:text-6xl">{h2Title}</h2>
    <h3 class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 md:text-xl">{description}</h3>
    <div class="mt-7 flex flex-row gap-4">
      <Button href={href} text={textButton} isGhost={true} />
      <Button href="/services" text="Ver servicios" isGhost={false} />
    </div>
  </div>
</article>

