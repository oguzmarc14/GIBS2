---
import Button from "./Button.astro";

interface Props {
  h2Title: string;
  srcImage: string;
  description: string;
  class?: string;
  isGhost?: boolean;
  textButton1: string;
  textButton2: string;
  hrefButton1: string;
  hrefButton2: string;
}

const {
  h2Title,
  srcImage,
  description,
  class: className = "",
  textButton1,
  textButton2,
  hrefButton1,
  hrefButton2,
} = Astro.props as Props;
---

<article class:list={["relative", className]}>
  <img
    class="h-200 w-full object-cover"
    src={srcImage}
    alt="Imagen de batería"
  />

  <div class:list={["absolute", "inset-0", "bg-black/20"]}></div>
  <div
    class:list={[
      "w-3/4",
      "absolute",
      "top-1/2",
      "left-1/2",
      "-translate-y-1/2",
      "-translate-x-1/2",
      "text-white",
      "hover:scale-105",
      "transition-transform",
      "duration-150",
      "text-center",
      "z-10",
      "flex",
      "flex-col",
    ]}
  >
    <h1
      class:list={[
        "font-bold",
        "mb-4",
        "lg:text-5xl xl:text-6xl sm:text-3xl text-4xl w-5/8 mx-auto",
      ]}
    >
      {h2Title}
    </h1>
    <h3 class:list={["text-xs", "ml-1"]}>{description}</h3>
    <div
      class:list={["flex", "sm:flex-row", "flex-col", "mx-auto", "sm:gap-8"]}
    >
      <Button href={hrefButton1} text={textButton1} isGhost={true} />
      <Button href={hrefButton2} text={textButton2} isGhost={false} />
    </div>
  </div>
</article>
