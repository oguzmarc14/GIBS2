---
import Layout from "../layouts/Layout.astro";
import Servicess from "../components/sections/Servicess.astro";
import Subheader from "../components/ui/Subheader.astro";
import Nueva from "../components/sections/Nueva.astro";
import Sub from "../components/sections/Sub.astro"
import Localidad from "../components/sections/Localidad.astro"
---

<Layout>
  <Subheader
    srcImg="/logo.png"
    h1Title="GIBS"
    option1="Home"
    option2="Services"
    option3="Chargers"
    option4="About GIBS"
    option5="Contact Us"
  />
  <Sub/>
  <Nueva/>
  <Localidad/>
</Layout>

