---
import Layout from "../layouts/Layout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import NavBar from "../components/ui/NavBar.astro";
import CardsService from "../components/sections/CardsService.astro";
---

<Layout>
  <Header
    h1Title="GIBS"
    description="Industrial battery service"
  >
    <NavBar
      option1="Home"
      option2="Services"
      option3="Chargers"
      option4="Contact Us"
      href1="/"
      href2="/services"
      href3="/baterias"
      href4="/contacto"
    />
  </Header>
   
<section
  id="services"
  class:list={[
    "relative",
    "overflow-hidden",
    "w-full",
    "bg-gradient-to-b",
    "from-[#0b3b22]",
    "via-[#145a35]",
    "to-[#0b3b22]",
  ]}
>
  <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-400/20 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16 md:py-20">
    <div class="text-center mb-10 sm:mb-14">
      <p class="mb-4 text-sm font-semibold tracking-[0.28em] text-emerald-200 uppercase">
        Professional Support
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-5 sm:mb-6 leading-tight">
        Industrial battery services built for uptime
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-emerald-100/90 max-w-4xl font-serif mx-auto">
        From diagnostics and repair to maintenance and charger support, our
        team keeps your fleet reliable, safe, and ready for daily operations.
      </p>
    </div>

    <div class="mx-auto mb-10 sm:mb-12 max-w-5xl rounded-2xl border border-emerald-200/20 bg-white/6 p-5 sm:p-7 text-emerald-50/90 backdrop-blur-sm shadow-[0_16px_35px_rgba(0,0,0,0.25)]">
      <p class="text-sm sm:text-base md:text-lg leading-relaxed">
        Green Industrial Battery Service (GIBS) is a trusted partner for
        industrial battery repair, forklift battery maintenance, charger
        diagnostics, and preventive battery service programs. Our technicians
        help warehouses and material handling operations reduce downtime,
        improve battery life, and maintain safe charging environments.
      </p>
      <p class="mt-4 text-sm sm:text-base md:text-lg leading-relaxed">
        We provide complete battery and charger support, including battery
        replacement, acid adjustment, cleaning and neutralization, watering
        system service, charging station inspections, and emergency charger
        repair. Whether your operation needs one-time service or scheduled
        industrial battery maintenance, GIBS delivers reliable, cost-effective
        solutions built for long-term performance.
      </p>
    </div>

    <div class="mx-auto max-w-5xl mb-10 sm:mb-12">
      <p class="text-center text-sm sm:text-base md:text-lg text-emerald-100/90 leading-relaxed">
        We provide industrial battery repair, forklift battery maintenance,
        charger diagnostics, and preventive battery services designed to improve
        uptime, reduce equipment failures, and extend battery performance for
        warehouse and material handling operations.
      </p>
      <h3 class="mt-5 text-center text-xl sm:text-2xl md:text-3xl font-bold text-white leading-tight">
        These are some of the services we provide
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 sm:gap-8 items-stretch justify-items-center">
      <CardsService />
    </div>
  </div>
</section>

  <Footer companyName="GIBS" />
</Layout>


