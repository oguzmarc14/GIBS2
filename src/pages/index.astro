---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header.astro';
import NavBar from '../components/ui/NavBar.astro';
import Cards from '../components/sections/Cards.astro';
import ReparacionesBaterias from '../components/sections/ReparacionesBaterias.astro';
import Footer from '../components/ui/Footer.astro';
import Localidad from '../components/sections/Localidad.astro';
---

<Layout>
    <Header srcImg="/logo.png" h1Title="GIBS" h2Title="We clean and repair battery systems" slogan="Industrial Battery Service"/>
    <NavBar option1="Home" option2="Services" option3="Chargers" option4="About GIBS" option5="Contact Us"/>
    <ReparacionesBaterias/>
    <Cards class='mt-20'/>
    <Localidad/>
    <Footer/>
</Layout>
