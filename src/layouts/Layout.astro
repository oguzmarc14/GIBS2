---
import "../styles/global.css";
import WhatsappBoton from "../components/sections/WhatsappBoton.astro";
---

<!doctype html>
<html lang="en">
<head>
  <!-- Charset -->
  <meta charset="UTF-8" />

  <!-- Responsive -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO -->
  <title>GIBS | Refurbished Forklift Batteries & Chargers</title>

  <meta
    name="description"
    content="Professionally refurbished forklift batteries and chargers. Reliable performance, warranty included, competitive pricing, and fast delivery."
  />

  <meta
    name="keywords"
    content="forklift batteries, refurbished forklift batteries, industrial batteries, forklift chargers, battery repair"
  />

  <meta name="author" content="Green Industrial Battery Service" />

  <meta name="robots" content="index, follow" />

  <!-- Canonical -->
  <link rel="canonical" href="https://gibsbattery.com/" />

  <!-- Theme -->
  <meta name="theme-color" content="#145A35" />

  <!-- Favicon -->
  <link rel="icon" href="/logo.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="GIBS | Refurbished Forklift Batteries" />
  <meta
    property="og:description"
    content="Reliable refurbished forklift batteries backed by warranty."
  />
  <meta property="og:image" content="/images/og-image.jpg" />
  <meta property="og:url" content="https://gibsbattery.com/" />
  <meta property="og:site_name" content="GIBS" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta
    name="twitter:title"
    content="GIBS | Refurbished Forklift Batteries"
  />
  <meta
    name="twitter:description"
    content="Reliable refurbished forklift batteries backed by warranty."
  />
  <meta name="twitter:image" content="/images/og-image.jpg" />

  <!-- Astro -->
  <meta name="generator" content={Astro.generator} />
</head>

<body>
  <slot />
<WhatsappBoton />
  

  <script>
    const revealElements = Array.from(document.querySelectorAll("[data-reveal]"));

    if (revealElements.length > 0) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          }
        },
        {
          threshold: 0.15,
          rootMargin: "0px 0px -8% 0px",
        }
      );

      revealElements.forEach((element) => observer.observe(element));
    }
  </script>
</body>
</html>

<style is:global>
html {
  scroll-behavior: smooth;
}

html,
body {
  margin: 0;
  width: 100%;
  min-height: 100%;
}
</style>